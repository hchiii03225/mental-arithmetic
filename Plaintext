            0% { background-color: rgba(254, 226, 226, 0.95); }
            100% { background-color: transparent; }
        }
        @keyframes flashGreen {
            0% { background-color: rgba(220, 252, 231, 0.95); }
            100% { background-color: transparent; }
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-center items-center p-4 sm:p-6 transition-colors duration-200" id="body-container">

    <main class="w-full max-w-lg mx-auto flex-1 flex flex-col justify-center items-center">

        <!-- =================== 1. 首頁 (Home Menu - 上下排列) =================== -->
        <section id="view-menu" class="w-full flex flex-col items-center my-auto">
            <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight text-center mb-8">
                三位數加法 心算練習
            </h1>

            <div class="w-full flex flex-col gap-6">
                <!-- 上方：出題模式區塊 -->
                <div class="w-full bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/90 shadow-sm flex flex-col gap-4">
                    <button onclick="startExaminerMode()" class="w-full py-4 px-6 bg-indigo-50/80 hover:bg-indigo-100/90 active:scale-[0.99] border-2 border-indigo-500/25 hover:border-indigo-500/60 rounded-2xl flex items-center justify-center gap-3.5 transition-all shadow-sm group">
                        <span class="text-2xl transform group-hover:scale-110 transition-transform">🎯</span>
                        <span class="text-xl font-black text-indigo-900 tracking-wide">出題模式</span>
                    </button>
                    <!-- 灰色清單說明 -->
                    <ul class="text-xs sm:text-[13px] text-slate-500 space-y-1.5 px-3 leading-relaxed">
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>供考官使用。</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>每兩分鐘自動更新題目。</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>可檢閱上/下一題題目。</span>
                        </li>
                    </ul>
                </div>

                <!-- 下方：答題模式區塊 -->
                <div class="w-full bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/90 shadow-sm flex flex-col gap-4">
                    <button onclick="startPracticeMode()" class="w-full py-4 px-6 bg-emerald-50/80 hover:bg-emerald-100/90 active:scale-[0.99] border-2 border-emerald-500/25 hover:border-emerald-500/60 rounded-2xl flex items-center justify-center gap-3.5 transition-all shadow-sm group">
                        <span class="text-2xl transform group-hover:scale-110 transition-transform">⚡</span>
                        <span class="text-xl font-black text-emerald-900 tracking-wide">答題模式</span>
                    </button>
                    <!-- 灰色清單說明 -->
                    <ul class="text-xs sm:text-[13px] text-slate-500 space-y-1.5 px-3 leading-relaxed">
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>自我挑戰心算速度。</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>為擬真考試狀況，預設三秒後隱藏題目。</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                            <span>隱藏功能可由按鈕關閉或開啟。</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- =================== 2. 答題模式 (Practice View) =================== -->
        <section id="view-practice" class="w-full hidden flex-col items-center">
            
            <!-- 上方控制區：隱藏題目功能與獨立三鍵 (暫停、結算、回首頁) -->
            <div class="w-full flex flex-wrap items-center justify-between gap-2.5 mb-4">
                <button id="toggle-hide-btn" onclick="toggleHideSetting()" class="flex items-center gap-2 px-3.5 py-2 bg-white border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50 transition active:scale-95">
                    <span id="hide-status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <span>隱藏題目功能</span>
                    <span id="hide-status-badge" class="text-[11px] px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-600">開啟</span>
                </button>

                <div class="flex items-center gap-2">
                    <button id="pause-btn" onclick="togglePausePractice()" class="px-3.5 py-2 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-2xl text-xs font-bold transition active:scale-95 flex items-center gap-1">
                        <span id="pause-icon">⏸</span>
                        <span id="pause-btn-text">暫停</span>
                    </button>
                    <button onclick="finishPractice()" class="px-3.5 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-2xl text-xs font-bold transition active:scale-95">
                        結算
                    </button>
                    <button onclick="goToMenu()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl text-xs font-bold transition active:scale-95">
                        回首頁
                    </button>
                </div>
            </div>

            <!-- 主作答卡片 -->
            <div class="w-full bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm relative overflow-hidden flex flex-col items-center">
                
                <!-- 題目顯示滿3秒後才啟動計時的時間條 -->
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden mb-4 relative">
                    <div id="elapsed-bar" class="h-full bg-emerald-500 rounded-full transition-all ease-linear w-0"></div>
                </div>

                <!-- 題號與獨立計時秒數 -->
                <div class="w-full flex items-center justify-between text-xs font-mono font-bold text-slate-400 mb-2">
                    <span id="practice-index-badge">第 1 題</span>
                    <div class="flex items-center gap-1.5 text-slate-700 bg-slate-100 px-3 py-1 rounded-xl">
                        <span id="phase-status-label" class="text-[11px] font-sans font-semibold text-emerald-600">準備心算...</span>
                        <span id="practice-timer" class="font-mono font-extrabold">0.0 秒</span>
                    </div>
                </div>

                <!-- 題目顯示/隱藏區域 -->
                <div class="min-h-[110px] sm:min-h-[130px] flex items-center justify-center my-3 text-center w-full">
                    <div id="question-text" class="text-4xl sm:text-5xl font-mono font-extrabold tracking-wider text-slate-900 flex items-center justify-center flex-wrap gap-2">
                        <span>---</span>
                        <span class="text-emerald-600 font-light">+</span>
                        <span>---</span>
                    </div>
                    <div id="question-masked" class="hidden flex-col items-center justify-center text-slate-400 space-y-1">
                        <div class="px-6 py-3.5 rounded-2xl bg-slate-100 border border-slate-200/70 font-mono font-bold text-lg text-slate-600 tracking-wider">
                            🧠 [ 題目已隱藏・心算中 ]
                        </div>
                    </div>
                </div>

                <!-- 答題反饋提示 -->
                <div id="feedback-msg" class="h-6 text-xs sm:text-sm font-bold flex items-center justify-center mb-2">
                    <span class="text-slate-400">請輸入答案並按確認</span>
                </div>

                <!-- 輸入框與送出按鈕 -->
                <form id="practice-form" onsubmit="handleAnswerSubmit(event)" class="w-full flex flex-col sm:flex-row gap-3">
                    <input 
                        type="number" 
                        inputmode="numeric" 
                        pattern="[0-9]*" 
                        id="user-answer-input" 
                        placeholder="請輸入答案" 
                        autocomplete="off"
                        class="flex-1 text-center font-mono font-bold text-2xl py-3.5 px-4 rounded-2xl border-2 border-slate-200 focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/10 transition-all text-slate-900 placeholder:text-slate-300 placeholder:text-base"
                    />
                    <button 
                        type="submit" 
                        id="submit-answer-btn"
                        class="w-full sm:w-auto px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-2xl shadow transition text-base flex items-center justify-center gap-1.5"
                    >
                        <span>確認</span>
                    </button>
                </form>
            </div>
        </section>

        <!-- =================== 3. 結算畫面 (Summary View) =================== -->
        <section id="view-summary" class="w-full hidden flex-col items-center my-auto">
            <div class="w-full bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col items-center">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-3xl mb-3">
                    🏁
                </div>
                <h2 class="text-2xl font-black text-slate-900">心算成果結算</h2>
                <p class="text-xs text-slate-400 mt-1 mb-5">每題獨立計時，未作答完成之題數不納入採計</p>

                <div class="w-full grid grid-cols-2 gap-3 mb-5">
                    <div class="bg-slate-50 rounded-2xl p-4 text-center border border-slate-100">
                        <span class="text-xs text-slate-400 block font-medium">完成題數</span>
                        <span id="summary-total-count" class="text-2xl font-mono font-black text-slate-800">0</span>
                        <span class="text-[11px] text-slate-500">題</span>
                    </div>
                    <div class="bg-slate-50 rounded-2xl p-4 text-center border border-slate-100">
                        <span class="text-xs text-slate-400 block font-medium">平均心算時間</span>
                        <span id="summary-avg-time" class="text-2xl font-mono font-black text-emerald-600">0.0</span>
                        <span class="text-[11px] text-slate-500">秒</span>
                    </div>
                </div>

                <div class="w-full mb-6">
                    <div class="text-xs font-bold text-slate-400 mb-2 flex justify-between px-1">
                        <span>題目</span>
                        <span>心算時間</span>
                    </div>
                    <div id="summary-list" class="max-h-60 overflow-y-auto space-y-2 pr-1"></div>
                </div>

                <div class="w-full flex gap-3">
                    <button onclick="startPracticeMode()" class="flex-1 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl text-sm transition active:scale-98">
                        再練一次
                    </button>
                    <button onclick="goToMenu()" class="px-6 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl text-sm transition active:scale-98">
                        回首頁
                    </button>
                </div>
            </div>
        </section>

        <!-- =================== 4. 出題模式 (Examiner View) =================== -->
        <section id="view-examiner" class="w-full hidden flex-col items-center my-auto">
            
            <div class="w-full flex items-center justify-between mb-4 px-1">
                <h2 class="text-lg font-bold text-slate-900">出題模式</h2>
                <button onclick="exitExaminerMode()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-600 rounded-xl text-xs font-bold transition active:scale-95">
                    退出
                </button>
            </div>

            <!-- 主算式展示大卡片 -->
            <div class="w-full bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/90 shadow-sm text-center flex flex-col items-center justify-center relative">
                
                <div class="w-full my-6 py-6 px-2 bg-slate-50/80 rounded-2xl border border-slate-100 flex items-center justify-center">
                    <div id="examiner-formula" class="text-3xl sm:text-5xl font-mono font-extrabold text-slate-900 tracking-wide flex flex-wrap items-center justify-center gap-2">
                        <span>---</span>
                        <span class="text-indigo-600 font-light">+</span>
                        <span>---</span>
                        <span class="text-slate-400">=</span>
                        <span class="text-indigo-600 font-black">---</span>
                    </div>
                </div>

                <!-- 倒數時間條 (2分鐘自動換題) -->
                <div class="w-full flex flex-col items-center space-y-1">
                    <div class="text-[11px] font-mono text-slate-400">
                        自動換題倒數：<span id="examiner-countdown-text" class="font-bold text-slate-600">120 秒</span>
                    </div>
                    <div class="w-48 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div id="examiner-progress-bar" class="h-full bg-indigo-400 w-full transition-all ease-linear"></div>
                    </div>
                </div>
            </div>

            <!-- 上一題 / 下一題控制按鈕 -->
            <div class="w-full flex items-center justify-between gap-4 mt-6">
                <button id="examiner-prev-btn" onclick="examinerPrevQuestion()" class="flex-1 py-3.5 px-4 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:hover:bg-white text-slate-700 font-bold rounded-2xl border border-slate-200 text-sm shadow-sm transition active:scale-98 flex items-center justify-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    回上一題
                </button>
                <button onclick="examinerNextQuestion()" class="flex-1 py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl text-sm shadow-sm hover:shadow transition active:scale-98 flex items-center justify-center gap-1.5">
                    跳下一題
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </section>

    </main>

    <script>
        /**
         * 高進位三位數演算法（計算進位次數，篩選具挑戰性的算式）
         */
        function countCarries(a, b) {
            let carry = 0;
            let count = 0;
            let n1 = a;
            let n2 = b;
            while (n1 > 0 || n2 > 0) {
                const sum = (n1 % 10) + (n2 % 10) + carry;
                if (sum >= 10) {
                    count++;
                    carry = 1;
                } else {
                    carry = 0;
                }
                n1 = Math.floor(n1 / 10);
                n2 = Math.floor(n2 / 10);
            }
            return count;
        }

        function generateHardThreeDigitAddition() {
            for (let i = 0; i < 200; i++) {
                const n1 = Math.floor(Math.random() * 800) + 120;
                const n2 = Math.floor(Math.random() * 800) + 120;
                if (countCarries(n1, n2) >= 2) {
                    return { num1: n1, num2: n2, sum: n1 + n2 };
                }
            }
            return { num1: 587, num2: 476, sum: 1063 };
        }

        // ================= 狀態管理 =================
        const bodyElement = document.getElementById('body-container');

        let practiceConfig = {
            hideEnabled: true
        };

        let practiceState = {
            currentIndex: 0,
            currentQuestion: null,
            phase: 'viewing', // 'viewing' (前3秒看題) -> 'calculating' (3秒後計時)
            viewingTimeout: null,
            timerInterval: null,
            elapsedMilliseconds: 0,
            isPaused: false,
            historyResults: []
        };

        let examinerState = {
            history: [],
            currentIndex: -1,
            remainingSeconds: 120,
            intervalId: null
        };

        function switchView(viewId) {
            document.getElementById('view-menu').classList.add('hidden');
            document.getElementById('view-practice').classList.add('hidden');
            document.getElementById('view-summary').classList.add('hidden');
            document.getElementById('view-examiner').classList.add('hidden');

            document.getElementById(viewId).classList.remove('hidden');
        }

        function goToMenu() {
            clearPracticeTimers();
            clearExaminerTimers();
            switchView('view-menu');
        }

        // ================= 答題模式邏輯 =================
        function startPracticeMode() {
            practiceState.currentIndex = 0;
            practiceState.historyResults = [];
            practiceState.isPaused = false;
            updatePauseButtonUI(false);
            switchView('view-practice');
            loadNextPracticeQuestion();
        }

        function toggleHideSetting() {
            practiceConfig.hideEnabled = !practiceConfig.hideEnabled;
            updateHideSettingUI();

            if (!practiceConfig.hideEnabled) {
                document.getElementById('question-masked').classList.add('hidden');
                document.getElementById('question-text').classList.remove('hidden');
            } else if (practiceState.phase === 'calculating') {
                document.getElementById('question-text').classList.add('hidden');
                document.getElementById('question-masked').classList.remove('hidden');
            }
        }

        function updateHideSettingUI() {
            const dot = document.getElementById('hide-status-dot');
            const badge = document.getElementById('hide-status-badge');
            if (practiceConfig.hideEnabled) {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
                badge.className = 'text-[11px] px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-600';
                badge.textContent = '開啟';
            } else {
                dot.className = 'w-2.5 h-2.5 rounded-full bg-slate-300';
                badge.className = 'text-[11px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-500';
                badge.textContent = '關閉';
            }
        }

        function loadNextPracticeQuestion() {
            clearPracticeTimers();
            practiceState.currentIndex++;
            practiceState.currentQuestion = generateHardThreeDigitAddition();
            practiceState.elapsedMilliseconds = 0;
            practiceState.phase = 'viewing';
            practiceState.isPaused = false;
            updatePauseButtonUI(false);

            document.getElementById('practice-index-badge').textContent = `第 ${practiceState.currentIndex} 題`;
            document.getElementById('practice-timer').textContent = '0.0 秒';
            document.getElementById('elapsed-bar').style.width = '0%';
            document.getElementById('feedback-msg').innerHTML = '<span class="text-slate-400">請輸入答案並按確認</span>';
            document.getElementById('phase-status-label').textContent = '看題中 (3秒)';
            document.getElementById('phase-status-label').className = 'text-[11px] font-sans font-semibold text-amber-600';

            const input = document.getElementById('user-answer-input');
            input.value = '';
            input.disabled = false;
            input.focus();

            const q = practiceState.currentQuestion;
            document.getElementById('question-text').innerHTML = `
                <span>${q.num1}</span>
                <span class="text-emerald-600 font-light">+</span>
                <span>${q.num2}</span>
            `;
            document.getElementById('question-text').classList.remove('hidden');
            document.getElementById('question-masked').classList.add('hidden');

            // 前三秒純看題，三秒後才開始計算時間並隱藏題目
            practiceState.viewingTimeout = setTimeout(() => {
                startCalculationPhase();
            }, 3000);
        }

        function startCalculationPhase() {
            practiceState.phase = 'calculating';
            document.getElementById('phase-status-label').textContent = '計時中';
            document.getElementById('phase-status-label').className = 'text-[11px] font-sans font-semibold text-emerald-600';

            if (practiceConfig.hideEnabled) {
                document.getElementById('question-text').classList.add('hidden');
                document.getElementById('question-masked').classList.remove('hidden');
            }

            startCalculationTimer();
        }

        function startCalculationTimer() {
            const startMark = performance.now() - practiceState.elapsedMilliseconds;
            practiceState.timerInterval = setInterval(() => {
                practiceState.elapsedMilliseconds = performance.now() - startMark;
                const totalSec = (practiceState.elapsedMilliseconds / 1000).toFixed(1);
                document.getElementById('practice-timer').textContent = `${totalSec} 秒`;

                const barPercent = Math.min(100, (practiceState.elapsedMilliseconds / 20000) * 100);
                document.getElementById('elapsed-bar').style.width = `${barPercent}%`;
            }, 60);
        }

        function clearPracticeTimers() {
            clearTimeout(practiceState.viewingTimeout);
            clearInterval(practiceState.timerInterval);
        }

        function togglePausePractice() {
            if (!practiceState.isPaused) {
                practiceState.isPaused = true;
                clearPracticeTimers();
                updatePauseButtonUI(true);
                document.getElementById('phase-status-label').textContent = '已暫停';
                document.getElementById('phase-status-label').className = 'text-[11px] font-sans font-semibold text-rose-500';
                document.getElementById('user-answer-input').disabled = true;
            } else {
                practiceState.isPaused = false;
                updatePauseButtonUI(false);
                document.getElementById('user-answer-input').disabled = false;
                document.getElementById('user-answer-input').focus();

                if (practiceState.phase === 'viewing') {
                    document.getElementById('phase-status-label').textContent = '看題中 (3秒)';
                    document.getElementById('phase-status-label').className = 'text-[11px] font-sans font-semibold text-amber-600';
                    practiceState.viewingTimeout = setTimeout(() => {
                        startCalculationPhase();
                    }, 1500);
                } else {
                    document.getElementById('phase-status-label').textContent = '計時中';
                    document.getElementById('phase-status-label').className = 'text-[11px] font-sans font-semibold text-emerald-600';
                    startCalculationTimer();
                }
            }
        }

        function updatePauseButtonUI(isPaused) {
            const btnText = document.getElementById('pause-btn-text');
            const icon = document.getElementById('pause-icon');
            if (isPaused) {
                btnText.textContent = '繼續';
                icon.textContent = '▶';
            } else {
                btnText.textContent = '暫停';
                icon.textContent = '⏸';
            }
        }

        function handleAnswerSubmit(e) {
            e.preventDefault();
            if (practiceState.isPaused) return;

            const inputEl = document.getElementById('user-answer-input');
            const val = parseInt(inputEl.value.trim(), 10);
            if (isNaN(val)) return;

            const targetSum = practiceState.currentQuestion.sum;

            if (val === targetSum) {
                clearPracticeTimers();
                const spentSec = Math.max(0.1, (practiceState.elapsedMilliseconds / 1000)).toFixed(1);

                practiceState.historyResults.push({
                    index: practiceState.currentIndex,
                    num1: practiceState.currentQuestion.num1,
                    num2: practiceState.currentQuestion.num2,
                    sum: targetSum,
                    timeSec: parseFloat(spentSec)
                });

                bodyElement.classList.add('flash-correct');
                document.getElementById('feedback-msg').innerHTML = `<span class="text-emerald-600 font-bold">✓ 正確！心算耗時 ${spentSec} 秒</span>`;

                setTimeout(() => {
                    bodyElement.classList.remove('flash-correct');
                    loadNextPracticeQuestion();
                }, 400);

            } else {
                // 答錯：閃淡紅，計時不停止持續計時
                bodyElement.classList.add('flash-wrong');
                document.getElementById('feedback-msg').innerHTML = '<span class="text-rose-500 font-bold">✕ 計算錯誤，請繼續心算（計時中）</span>';
                inputEl.select();

                setTimeout(() => {
                    bodyElement.classList.remove('flash-wrong');
                }, 500);
            }
        }

        function finishPractice() {
            clearPracticeTimers();
            showSummaryView();
        }

        function showSummaryView() {
            switchView('view-summary');
            const listEl = document.getElementById('summary-list');
            listEl.innerHTML = '';

            const list = practiceState.historyResults;
            document.getElementById('summary-total-count').textContent = list.length;

            if (list.length === 0) {
                document.getElementById('summary-avg-time').textContent = '0.0';
                listEl.innerHTML = `
                    <div class="py-8 text-center text-xs text-slate-400">
                        本次尚未完成任何一題即結算。
                    </div>
                `;
                return;
            }

            const total = list.reduce((a, b) => a + b.timeSec, 0);
            const avg = (total / list.length).toFixed(1);
            document.getElementById('summary-avg-time').textContent = avg;

            list.forEach((item) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between p-3 bg-slate-50 border border-slate-100 rounded-2xl text-xs sm:text-sm';
                row.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 text-xs font-mono font-bold flex items-center justify-center">
                            ${item.index}
                        </span>
                        <span class="font-mono font-bold text-slate-800">
                            ${item.num1} + ${item.num2} = ${item.sum}
                        </span>
                    </div>
                    <span class="font-mono font-bold text-slate-600 bg-white px-2.5 py-1 rounded-xl border border-slate-200">
                        ${item.timeSec.toFixed(1)} 秒
                    </span>
                `;
                listEl.appendChild(row);
            });
        }

        // ================= 出題模式邏輯 =================
        function startExaminerMode() {
            clearExaminerTimers();
            examinerState.history = [];
            examinerState.currentIndex = -1;
            switchView('view-examiner');
            examinerNextQuestion();
        }

        function renderExaminerQuestion() {
            const currentQ = examinerState.history[examinerState.currentIndex];
            const formulaEl = document.getElementById('examiner-formula');
            const prevBtn = document.getElementById('examiner-prev-btn');

            formulaEl.innerHTML = `
                <span>${currentQ.num1}</span>
                <span class="text-indigo-600 font-light">+</span>
                <span>${currentQ.num2}</span>
                <span class="text-slate-400">=</span>
                <span class="text-indigo-600 font-black">${currentQ.sum}</span>
            `;

            prevBtn.disabled = examinerState.currentIndex <= 0;
            resetExaminerAutoTimer();
        }

        function examinerNextQuestion() {
            if (examinerState.currentIndex < examinerState.history.length - 1) {
                examinerState.currentIndex++;
            } else {
                examinerState.history.push(generateHardThreeDigitAddition());
                examinerState.currentIndex++;
            }
            renderExaminerQuestion();
        }

        function examinerPrevQuestion() {
            if (examinerState.currentIndex > 0) {
                examinerState.currentIndex--;
                renderExaminerQuestion();
            }
        }

        function resetExaminerAutoTimer() {
            clearInterval(examinerState.intervalId);
            examinerState.remainingSeconds = 120;
            updateExaminerTimerUI();

            examinerState.intervalId = setInterval(() => {
                examinerState.remainingSeconds--;
                updateExaminerTimerUI();
                if (examinerState.remainingSeconds <= 0) {
                    examinerNextQuestion();
                }
            }, 1000);
        }

        function updateExaminerTimerUI() {
            document.getElementById('examiner-countdown-text').textContent = `${examinerState.remainingSeconds} 秒`;
            const pct = (examinerState.remainingSeconds / 120) * 100;
            document.getElementById('examiner-progress-bar').style.width = `${pct}%`;
        }

        function clearExaminerTimers() {
            clearInterval(examinerState.intervalId);
        }

        function exitExaminerMode() {
            clearExaminerTimers();
            goToMenu();
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateHideSettingUI();
        });
    </script>
</body>
</html>
